{
  "name": "bench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "verify:addresses": "bun run scripts/verify-addresses.ts",
    "gate": "bun run typecheck && bun run test && bun run test:contracts",
    "start": "bun run src/server.ts",
    "dev": "DEV_ALLOWANCE=5 bun run src/server.ts",
    "test:contracts": "cd contracts && forge test",
    "verify:abi": "bun run scripts/verify-abi.ts",
    "demo:local": "bash scripts/local-loop.sh",
    "probe:facilitator": "bun run scripts/probe-facilitator.ts",
    "pay:once": "bun run scripts/pay-once.ts",
    "top-up": "bun run scripts/top-up.ts",
    "arbiter:key": "bun run scripts/arbiter-key.ts",
    "deploy:escrow": "bun run scripts/deploy-escrow.ts",
    "fund": "bun run scripts/fund.ts",
    "bounty:real": "bun run scripts/real-bounty.ts"
  },
  "dependencies": {
    "viem": "2.45.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.9.3"
  }
}
